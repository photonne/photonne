{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"map_label": "Mapa de fotos. Flechas para moverte, + y − para acercar o alejar.",
	"map_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} foto con ubicación",
				"countPlural=other": "{countFormatted} fotos con ubicación"
			}
		}
	],
	"map_empty_title": "Sin fotos con ubicación",
	"map_empty_body": "Cuando tus fotos lleven coordenadas GPS aparecerán aquí, sobre el mapa.",
	"map_fit": "Ver todas",
	"map_zoom_in": "Acercar",
	"map_zoom_out": "Alejar",
	"map_cluster": [
		{
			"declarations": [
				"input count",
				"input range",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} foto, {range}",
				"countPlural=other": "{countFormatted} fotos, {range}"
			}
		}
	],
	"map_cluster_title": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} foto aquí",
				"countPlural=other": "{countFormatted} fotos aquí"
			}
		}
	],
	"map_cluster_close": "Cerrar el panel",
	"map_cluster_empty": "Estas fotos ya no están disponibles."
}
