{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"organize_lead": "What the automatic backup uploads waits here until you file it in a folder.",
	"organize_pending": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} pending",
