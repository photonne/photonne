	"search_submit": "Buscar",
	"search_filters": "Filtros",
	"search_filter_dates": "Fechas",
	"search_filter_from": "Desde",
	"search_filter_to": "Hasta",
	"search_filter_people": "Personas",
	"search_filter_objects": "Objetos",
	"search_filter_scenes": "Escenas",
	"search_filter_ocr": "Texto en la imagen",
	"search_filter_ocr_placeholder": "Texto dentro de la foto…",
	"search_filter_folder": "Carpeta",
	"search_filter_options": "Filtrar {list}",
	"search_filter_placeholder": "Filtrar…",
	"search_filter_nothing": "Nada que coincida.",
	"search_apply": "Aplicar",
	"search_loading": "Cargando…",
	"search_semantic_no_filters": "La búsqueda semántica solo usa las palabras.",
	"search_active_filters": "Filtros activos",
	"search_remove_filter": "Quitar el filtro {filter}",
	"search_clear_filters": "Quitar filtros",
	"search_chip_between": "Del {from} al {to}",
	"search_chip_from": "Desde el {date}",
	"search_chip_to": "Hasta el {date}",
	"search_chip_ocr": "Texto: «{text}»",
	"search_chip_folder": "En {folder}",
	"search_person_unnamed": "Sin nombre",
	"search_no_results": "Sin resultados. Prueba con otras palabras o con menos filtros.",
	"search_semantic_unavailable": "La búsqueda semántica no está disponible ahora mismo; se muestran los resultados de la búsqueda por texto.",
	"search_semantic_too_short": "Escribe entre 2 y 200 caracteres para la búsqueda semántica.",
	"search_semantic_capped": "Se muestran las {count} fotos más parecidas.",
	"search_discover_people": "Personas",
	"search_discover_scenes": "Escenas",
	"search_discover_objects": "Objetos",
	"search_discover_hint": "Busca por nombre de archivo, ruta, etiqueta o fecha, o activa la búsqueda semántica y descríbelo con tus palabras.",
	"search_results": "Resultados",
	"search_result_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} resultado",
				"countPlural=other": "{countFormatted} resultados"
			}
		}
	],
	"search_result_count_more": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "Más de {countFormatted} resultado",
				"countPlural=other": "Más de {countFormatted} resultados"
			}
		}
	],
	"search_discover_empty": "Busca en tu biblioteca"
}
