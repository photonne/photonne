	"$schema": "https://inlang.com/schema/inlang-message-format",
	"search_field_label": "Buscar en tu biblioteca",
	"search_field_placeholder": "Nombre, ruta o etiqueta…",
	"search_field_placeholder_semantic": "Describe lo que buscas: «perro en la playa al atardecer»…",
	"search_semantic": "Semántica",
