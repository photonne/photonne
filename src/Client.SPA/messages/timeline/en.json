{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"timeline_toolbar": "Timeline view",
	"timeline_zoom": "Thumbnail size",
	"timeline_zoom_in": "Larger thumbnails",
	"timeline_zoom_in_hint": "Larger thumbnails (+ or Ctrl + wheel)",
	"timeline_zoom_out": "Smaller thumbnails",
	"timeline_zoom_out_hint": "Smaller thumbnails (− or Ctrl + wheel)",
	"timeline_jump": "Go to a date",
	"timeline_jump_hint_short": "Go to a date (G)",
	"timeline_jump_title": "Go to a date",
	"timeline_jump_year": "Year",
	"timeline_jump_year_option": "{year} · {count}",
	"timeline_jump_months": "Months of {year}",
	"timeline_jump_month": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{month}, {countFormatted} item",
				"countPlural=other": "{month}, {countFormatted} items"
			}
		}
	],
	"timeline_jump_month_empty": "{month}, no photos",
	"timeline_jump_hint": "Shortcut: G. Months without photos are disabled.",
	"timeline_year_items": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} item",
				"countPlural=other": "{countFormatted} items"
			}
		}
	],
	"timeline_year_item": "Show {month}, from a photo of {date}",
	"timeline_range": "{from} – {to}",
	"timeline_empty_title": "No photos yet",
	"timeline_empty_hint": "Upload photos and videos and they will show up here, ordered by when they were taken.",
	"timeline_upload": "Upload photos",
	"timeline_group_year": "By year",
	"timeline_group_month": "By month",
	"timeline_group_day": "By day",
	"timeline_group_current": "Group: {grouping}",
	"timeline_group_changed": "Grouped {grouping}",
	"size_value": "{level}",
	"size_changed": "Size: {level}",
	"size_level_0": "Extra small",
	"size_level_1": "Small",
	"size_level_2": "Medium",
	"size_level_3": "Large",
	"size_level_4": "Extra large",
	"view_options": "View options",
	"view_layout": "Layout",
	"view_size": "Size",
	"filters": "Filters",
	"filters_jump": "Go to a date…",
	"filters_group": "Group by",
	"filters_order": "Order",
	"filters_order_newest": "Newest first",
	"filters_order_oldest": "Oldest first",
	"filters_dates": "Dates",
	"filters_dates_all": "All",
	"filters_dates_day": "One day",
	"filters_dates_range": "A range",
	"filters_from": "From",
	"filters_to": "To",
	"filters_day": "Day",
	"filters_clear": "Clear filters",
	"filters_active_day": "On {date}",
	"filters_active_range": "From {from} to {to}",
	"filters_none_in_range": "No photos on those dates."
}
