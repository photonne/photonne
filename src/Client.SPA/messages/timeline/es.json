	"timeline_jump_year_option": "{year} · {count}",
	"timeline_jump_months": "Meses de {year}",
	"timeline_jump_month": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{month}, {countFormatted} elemento",
				"countPlural=other": "{month}, {countFormatted} elementos"
			}
		}
	],
	"timeline_jump_month_empty": "{month}, sin fotos",
	"timeline_jump_hint": "Atajo: G. Los meses sin fotos aparecen desactivados.",
	"timeline_year_items": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} elemento",
				"countPlural=other": "{countFormatted} elementos"
			}
		}
	],
	"timeline_year_item": "Ver {month}, desde una foto del {date}",
	"timeline_range": "{from} – {to}",
