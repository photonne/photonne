-- Persistent identity map: one row per DEVICE-LIBRARY item whose server
-- identity has been (at least partially) established.
--
-- Keyed by the library's own uri (content://media/... on Android,
-- photokit:<localIdentifier> on iOS) — NOT the backup flow's SAF uris;
-- the ledger bridge translates those at overlay time. The
-- (sizeBytes, dateModifiedMillis) pair is the fingerprint: a mismatch
-- against the current enumeration means the file changed and the row's
-- sha256/assetId are stale.
--
-- sha256 NULL      → nothing established yet (row shouldn't exist).
-- assetId NULL     → hashed, but the server had no match when last
--                    checked (checkedAtMillis says when — re-checked
--                    lazily so a later upload from another device is
--                    eventually noticed).
-- assetId NOT NULL → authoritative: this device file IS that server
--                    asset. The timeline merge dedups on it.
--
-- Account-scoped exactly like backupLedger: BackupLedger.ensureScope
-- wipes this table in the same transaction, so identities never leak
-- across servers/users.
-- NOTE: displayName is declared last because it arrived via migration
-- (3.sqm) and ALTER TABLE appends columns — the declared order here must
-- match the on-disk order of migrated databases. It hardens the
-- (size, mtime) fingerprint bridge: a bare fingerprint can collide
-- across distinct files (batch exports writing same-size files in the
-- same second), and seeding a wrong sha256 silently marks a never-
-- uploaded file as Synced.
CREATE TABLE deviceIdentity (
    uri TEXT NOT NULL PRIMARY KEY,
    sizeBytes INTEGER NOT NULL,
    dateModifiedMillis INTEGER NOT NULL,
    sha256 TEXT,
    assetId TEXT,
    checkedAtMillis INTEGER,
    displayName TEXT
);

selectAllIdentities:
SELECT * FROM deviceIdentity;

upsertIdentity:
INSERT OR REPLACE INTO deviceIdentity(
    uri, sizeBytes, dateModifiedMillis, sha256, assetId, checkedAtMillis, displayName
)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteIdentitiesByUris:
DELETE FROM deviceIdentity WHERE uri IN ?;

clearIdentities:
DELETE FROM deviceIdentity;
