{
	"name": "Photonne",
	"short_name": "Photonne",
	"description": "Tu biblioteca de fotos",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone"],
	"background_color": "#111214",
	"theme_color": "#111214",
	"prefer_related_applications": false,
	"icons": [
		{ "src": "/icons/icon-192-dark.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
		{ "src": "/icons/icon-512-dark.png", "type": "image/png", "sizes": "512x512", "purpose": "any" }
	],
	"shortcuts": [
		{ "name": "Fotos", "url": "/", "icons": [{ "src": "/icons/icon-192-dark.png", "sizes": "192x192" }] },
		{ "name": "Buscar", "url": "/search", "icons": [{ "src": "/icons/icon-192-dark.png", "sizes": "192x192" }] },
		{ "name": "Álbumes", "url": "/albums", "icons": [{ "src": "/icons/icon-192-dark.png", "sizes": "192x192" }] },
		{ "name": "Subir", "url": "/upload", "icons": [{ "src": "/icons/icon-192-dark.png", "sizes": "192x192" }] }
	]
}
