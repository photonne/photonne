	"action_failed": "No se ha podido completar la acción.",
	"action_favorited": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countFormatted = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countFormatted} marcada como favorita",
				"countPlural=other": "{countFormatted} marcadas como favoritas"
			}
		}
	],
