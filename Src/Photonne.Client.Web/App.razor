@inject LayoutService LayoutService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(App).Assembly"
        OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>No encontrado</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudContainer>
                <MudText Typo="Typo.h3">Página no encontrada</MudText>
                <MudText>Lo sentimos, la página que buscas no existe.</MudText>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
                    Volver al inicio
                </MudButton>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private bool _initialized;

    private async Task OnNavigateAsync(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        if (!_initialized)
        {
            await LayoutService.InitializeAsync();
            _initialized = true;
        }

        var path = context.Path.Trim('/').ToLowerInvariant();

        // Public routes: login and the anonymous shared-link viewer.
        if (path.StartsWith("login") || path.StartsWith("share"))
        {
            return;
        }

        if (!await AuthService.IsAuthenticatedAsync())
        {
            var returnUrl = new Uri(Navigation.Uri).PathAndQuery;
            var loginUrl = BuildLoginUrl(returnUrl);
            Navigation.NavigateTo(loginUrl);
            return;
        }

        // Workspace de usuario (ADR-003): la web ya no es solo consola admin.
        // Cualquier usuario autenticado accede al workspace y a sus páginas
        // personales; las superficies de administración siguen siendo de Admin.
        var user = await AuthService.GetCurrentUserAsync();
        var isAdmin = string.Equals(user?.Role, "Admin", StringComparison.OrdinalIgnoreCase);

        if (!isAdmin)
        {
            if (path.Length == 0)
            {
                // La landing de un usuario es su biblioteca, no el panel admin.
                Navigation.NavigateTo("/fotos");
            }
            else if (!IsUserRoute(path))
            {
                Navigation.NavigateTo("/fotos");
            }
        }
        else if (path.StartsWith("use-the-app"))
        {
            Navigation.NavigateTo("/");
        }
    }

    // Rutas abiertas a cualquier usuario autenticado (el resto es admin).
    private static readonly string[] UserRoutePrefixes =
    {
        "fotos", "buscar", "albumes", "carpetas", "organizar",
        "favoritas", "archivadas", "papelera", "duplicados",
        "settings", "notifications", "use-the-app"
    };

    private static bool IsUserRoute(string path) =>
        UserRoutePrefixes.Any(path.StartsWith);

    private static string BuildLoginUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return "/login";
        }

        return $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }
}
