@using Photonne.Client.Web.Models
@using Photonne.Client.Web.Services
@inject IAssetService AssetService
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Rejilla del workspace sobre el modelo de buckets: una <section> por mes con
   la altura reservada (estimada por conteo hasta hidratar, exacta después),
   content-visibility:auto para que el navegador no pinte lo lejano, e
   hidratación bajo demanda vía IntersectionObserver (workspaceGrid.js). *@

<div class="photo-grid" @ref="_containerRef">
    @if (_sections == null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_sections.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.PhotoLibrary"
                    Title="Todavía no hay fotos"
                    Description="Cuando subas o sincronices fotos aparecerán aquí." />
    }
    else
    {
        @foreach (var section in _sections)
        {
            <section class="pg-month" data-bucket="@section.Key" @key="section.Key">
                <div class="pg-month-header">
                    @if (Selection != null && section.Items != null)
                    {
                        var (any, all) = Selection.StateOf(_idsBySection.GetValueOrDefault(section.Key) ?? new List<Guid>());
                        <button type="button"
                                class="pg-month-check @(all ? "all" : any ? "partial" : "")"
                                aria-label="Seleccionar mes"
                                @onclick="() => ToggleMonth(section, all)">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10" fill="@(any ? "var(--mud-palette-primary)" : "none")" stroke="currentColor" stroke-width="2"/>
                                @if (all)
                                {
                                    <path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                }
                                else if (any)
                                {
                                    <path d="M7.5 12h9" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/>
                                }
                            </svg>
                        </button>
                    }
                    <span class="pg-month-title">@FormatMonth(section.Key)</span>
                    <span class="pg-month-count">@section.Count</span>
                </div>
                <div class="pg-month-body"
                     style="content-visibility:auto;contain-intrinsic-size:auto @(Px(section.ContentHeight))">
                    @if (section.Layout != null && section.Items != null)
                    {
                        @foreach (var row in section.Layout.Rows)
                        {
                            <div class="pg-row" style="height:@(Px(row.Height))">
                                @for (var i = row.StartIndex; i < row.StartIndex + row.Count; i++)
                                {
                                    var item = section.Items[i];
                                    <PhotoCell @key="item.Id"
                                               Item="item"
                                               Width="CellWidth(item, row.Height)"
                                               Height="row.Height"
                                               IsSelected="Selection?.IsSelected(item.Id) ?? false"
                                               Selectable="Selection != null"
                                               OnClick="e => HandleCellClick(item, e)"
                                               OnToggle="() => Selection?.Toggle(item.Id)" />
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pg-skeleton" style="height:@(Px(section.ContentHeight))"></div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private const double TargetRowHeight = 200;
    private const double Spacing = 4;
    private const double MonthHeaderHeight = 52;

    [Parameter] public EventCallback<TimelineItem> OnItemClick { get; set; }
    /// <summary>Estado de selección compartido con la página; null = rejilla solo lectura.</summary>
    [Parameter] public SelectionState? Selection { get; set; }
    /// <summary>Atajo de teclado sobre la selección activa: "delete" | "favorite".</summary>
    [Parameter] public EventCallback<string> OnShortcut { get; set; }

    private sealed class Section
    {
        public required string Key { get; init; }
        // Mutable: papelera/archivar cambian el contenido real del mes.
        public required int Count { get; set; }
        public double ContentHeight { get; set; }
        public List<TimelineItem>? Items { get; set; }
        public JustifiedLayout.Result? Layout { get; set; }
        public bool Hydrating { get; set; }
    }

    private List<Section>? _sections;
    private ElementReference _containerRef;
    private DotNetObjectReference<PhotoGrid>? _selfRef;
    private int _jsId = -1;
    private double _containerWidth = 1200;
    private bool _sectionsObserved;
    // Ids por mes hidratado, para el checkbox tri-estado y el orden del rango.
    private readonly Dictionary<string, List<Guid>> _idsBySection = new();
    // true = el pintado por arrastre selecciona; false = deselecciona (según
    // el estado de la celda donde empezó).
    private bool _paintSelects = true;
    private SelectionState? _subscribedSelection;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribedSelection, Selection))
        {
            if (_subscribedSelection != null) _subscribedSelection.Changed -= OnSelectionChanged;
            _subscribedSelection = Selection;
            if (_subscribedSelection != null) _subscribedSelection.Changed += OnSelectionChanged;
        }
    }

    private void OnSelectionChanged() => StateHasChanged();

    /// <summary>Orden visible plano de los meses hidratados (para Shift+clic).</summary>
    public IReadOnlyList<Guid> VisibleOrder =>
        _sections == null
            ? Array.Empty<Guid>()
            : _sections.Where(s => s.Items != null)
                .SelectMany(s => _idsBySection.GetValueOrDefault(s.Key) ?? new List<Guid>())
                .ToList();

    /// <summary>Items hidratados en orden visible (los usa el visor).</summary>
    public IReadOnlyList<TimelineItem> VisibleItems =>
        _sections == null
            ? Array.Empty<TimelineItem>()
            : _sections.Where(s => s.Items != null).SelectMany(s => s.Items!).ToList();

    /// <summary>
    /// Retira assets de la rejilla tras una acción que los saca del timeline
    /// (papelera, archivar, mover no los saca — siguen visibles). Recalcula el
    /// layout de los meses afectados.
    /// </summary>
    public void RemoveAssets(IReadOnlyCollection<Guid> ids)
    {
        if (_sections == null || ids.Count == 0) return;
        var idSet = ids as ISet<Guid> ?? ids.ToHashSet();
        foreach (var section in _sections)
        {
            if (section.Items == null) continue;
            var removed = section.Items.RemoveAll(i => idSet.Contains(i.Id));
            if (removed > 0)
            {
                section.Count = section.Items.Count;
                _idsBySection[section.Key] = section.Items.Select(i => i.Id).ToList();
                RecomputeLayout(section);
            }
        }
        StateHasChanged();
    }

    /// <summary>Aplica una mutación in situ (favorito) y repinta.</summary>
    public void UpdateAssets(IReadOnlyCollection<Guid> ids, Action<TimelineItem> mutate)
    {
        if (_sections == null || ids.Count == 0) return;
        var idSet = ids as ISet<Guid> ?? ids.ToHashSet();
        foreach (var item in _sections.Where(s => s.Items != null).SelectMany(s => s.Items!))
        {
            if (idSet.Contains(item.Id)) mutate(item);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Vacía y vuelve a pedir meses concretos — el "Deshacer" de papelera y
    /// archivar restaura en servidor y rehidrata aquí.
    /// </summary>
    public async Task RehydrateMonthsAsync(IEnumerable<string> monthKeys)
    {
        if (_sections == null) return;
        foreach (var key in monthKeys.Distinct().ToList())
        {
            var section = _sections.FirstOrDefault(s => s.Key == key);
            if (section == null) continue;
            section.Items = null;
            section.Layout = null;
            _idsBySection.Remove(key);
            await OnBucketApproaching(key);
        }
    }

    /// <summary>Items hidratados seleccionables de un conjunto de ids.</summary>
    public IReadOnlyList<TimelineItem> ItemsByIds(IReadOnlyCollection<Guid> ids)
    {
        var idSet = ids as ISet<Guid> ?? ids.ToHashSet();
        return VisibleItems.Where(i => idSet.Contains(i.Id)).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        var buckets = await AssetService.GetTimelineBucketsAsync();
        _sections = buckets.Select(b => new Section
        {
            Key = b.Key,
            Count = b.Count,
            ContentHeight = JustifiedLayout.EstimateHeight(b.Count, _containerWidth, TargetRowHeight, Spacing)
        }).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _jsId = await JS.InvokeAsync<int>("workspaceGrid.init", _containerRef, _selfRef);
        }

        if (!_sectionsObserved && _jsId >= 0 && _sections is { Count: > 0 })
        {
            _sectionsObserved = true;
            await JS.InvokeVoidAsync("workspaceGrid.observeSections", _jsId);
        }
    }

    [JSInvokable]
    public Task OnContainerResized(double width)
    {
        if (Math.Abs(width - _containerWidth) < 1 || width <= 0) return Task.CompletedTask;
        _containerWidth = width;
        if (_sections != null)
        {
            foreach (var section in _sections)
            {
                RecomputeLayout(section);
            }
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnBucketApproaching(string key)
    {
        var section = _sections?.FirstOrDefault(s => s.Key == key);
        if (section == null || section.Items != null || section.Hydrating) return;

        section.Hydrating = true;
        List<TimelineItem> items;
        try
        {
            items = await AssetService.GetBucketItemsAsync(key);
        }
        catch
        {
            // Red caída o bucket fallido: se reintentará cuando el observer
            // vuelva a disparar (el usuario se aleja y vuelve).
            section.Hydrating = false;
            return;
        }

        var oldHeight = section.ContentHeight;
        section.Items = items;
        section.Count = items.Count;
        _idsBySection[section.Key] = items.Select(i => i.Id).ToList();
        RecomputeLayout(section);
        section.Hydrating = false;
        StateHasChanged();

        // Tras el render, si el mes quedó por encima del viewport el delta de
        // altura movería el contenido visible: compensar el scroll.
        var delta = section.ContentHeight - oldHeight;
        if (Math.Abs(delta) >= 1)
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("workspaceGrid.compensateIfAbove", _jsId, key, delta);
        }
    }

    private void RecomputeLayout(Section section)
    {
        if (section.Items != null)
        {
            var aspects = section.Items
                .Select(i => i.Width.HasValue && i.Height is > 0
                    ? (double)i.Width.Value / i.Height.Value
                    : JustifiedLayout.FallbackAspect)
                .ToList();
            section.Layout = JustifiedLayout.Compute(aspects, _containerWidth, TargetRowHeight, Spacing);
            section.ContentHeight = section.Layout.TotalHeight;
        }
        else
        {
            section.ContentHeight = JustifiedLayout.EstimateHeight(
                section.Count, _containerWidth, TargetRowHeight, Spacing);
        }
    }

    private Task HandleCellClick(TimelineItem item, MouseEventArgs e)
    {
        if (Selection == null) return OnItemClick.InvokeAsync(item);

        if (e.ShiftKey)
        {
            Selection.SelectRange(item.Id, VisibleOrder);
            return Task.CompletedTask;
        }
        if (e.CtrlKey || e.MetaKey || Selection.IsActive)
        {
            Selection.Toggle(item.Id);
            return Task.CompletedTask;
        }
        return OnItemClick.InvokeAsync(item);
    }

    private async Task ToggleMonth(Section section, bool allSelected)
    {
        if (Selection == null) return;
        if (section.Items == null)
        {
            // Mes sin hidratar: hidratarlo primero y seleccionarlo entero.
            await OnBucketApproaching(section.Key);
            if (section.Items == null) return;
        }
        var ids = _idsBySection.GetValueOrDefault(section.Key);
        if (ids != null) Selection.SetSelected(ids, !allSelected);
    }

    [JSInvokable]
    public void OnEscapePressed() => Selection?.Clear();

    [JSInvokable]
    public async Task OnGridShortcut(string action)
    {
        // Los atajos operan sobre la selección; sin selección no hacen nada.
        if (Selection is not { IsActive: true }) return;
        await OnShortcut.InvokeAsync(action);
    }

    [JSInvokable]
    public void OnPaintSelectStart(string assetId)
    {
        if (Selection == null || !Guid.TryParse(assetId, out var id)) return;
        // Pintar desde una celda seleccionada deselecciona; desde una sin
        // seleccionar, selecciona. El modo se mantiene todo el arrastre.
        _paintSelects = !Selection.IsSelected(id);
        Selection.SetSelected(new[] { id }, _paintSelects);
    }

    [JSInvokable]
    public void OnPaintSelect(string assetId)
    {
        if (Selection == null || !Guid.TryParse(assetId, out var id)) return;
        Selection.SetSelected(new[] { id }, _paintSelects);
    }

    private double CellWidth(TimelineItem item, double rowHeight)
    {
        var aspect = item.Width.HasValue && item.Height is > 0
            ? (double)item.Width.Value / item.Height.Value
            : JustifiedLayout.FallbackAspect;
        return Math.Clamp(aspect, 0.4, 3.0) * rowHeight;
    }

    private static string Px(double v) =>
        v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private static string FormatMonth(string key)
    {
        // key = "yyyy-MM"
        var parts = key.Split('-');
        if (parts.Length == 2 && int.TryParse(parts[0], out var year) && int.TryParse(parts[1], out var month)
            && month is >= 1 and <= 12)
        {
            var name = new DateTime(year, month, 1).ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));
            return char.ToUpper(name[0]) + name[1..];
        }
        return key;
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribedSelection != null) _subscribedSelection.Changed -= OnSelectionChanged;
        if (_jsId >= 0)
        {
            try { await JS.InvokeVoidAsync("workspaceGrid.dispose", _jsId); }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
