@using Photonne.Client.Web.Models

@* Celda mínima de la rejilla: miles de instancias, así que nada de MudBlazor
   ni servicios inyectados aquí — HTML plano, placeholder de color dominante
   con fundido al cargar (idea heredada del AssetCard retirado en b69b38e5) y
   badges como SVG inline. El tamaño lo dicta la fila justificada.

   data-asset-id alimenta el pintado por arrastre de workspaceGrid.js. El
   círculo de selección aparece al hover (o fijo si está seleccionada) y su
   clic solo alterna, sin abrir el visor. *@

<div class="photo-cell @(_loaded ? "loaded" : "") @(IsSelected ? "selected" : "")"
     data-asset-id="@Item.Id"
     style="width:@(Fmt(Width))px;height:@(Fmt(Height))px;background-color:@(Item.DominantColor ?? "#2a2a2c")"
     title="@Item.FileName"
     @onclick="e => OnClick.InvokeAsync(e)">
    <img src="@Item.ThumbnailUrl"
         alt="@Item.FileName"
         loading="lazy"
         decoding="async"
         draggable="false"
         @onload="() => _loaded = true"
         @onerror="() => _loaded = true" />
    @if (Item.IsVideo)
    {
        <svg class="pc-badge pc-badge-tr" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="rgba(0,0,0,.55)"/><path d="M9.5 7.5v9l7-4.5z" fill="#fff"/></svg>
    }
    else if (Item.IsLivePhoto)
    {
        <svg class="pc-badge pc-badge-tr" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="rgba(0,0,0,.55)"/><circle cx="12" cy="12" r="6" fill="none" stroke="#fff" stroke-width="1.6" stroke-dasharray="2.4 2"/><circle cx="12" cy="12" r="2.6" fill="#fff"/></svg>
    }
    @if (Item.IsFavorite)
    {
        <svg class="pc-badge pc-badge-br" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.7-10-9.3C.4 8 2 4.5 5.4 4.1 7.5 3.8 9.2 5 12 7.6 14.8 5 16.5 3.8 18.6 4.1 22 4.5 23.6 8 22 11.7 19.5 16.3 12 21 12 21z" fill="#ff5d8f" stroke="rgba(0,0,0,.35)" stroke-width="1"/></svg>
    }
    @if (Selectable)
    {
        <div class="pc-scrim"></div>
        <button type="button"
                class="pc-check"
                aria-label="@(IsSelected ? "Quitar de la selección" : "Seleccionar")"
                @onclick="() => OnToggle.InvokeAsync()"
                @onclick:stopPropagation="true">
            @if (IsSelected)
            {
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" class="pc-check-fill"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="rgba(0,0,0,.25)" stroke="#fff" stroke-width="2"/></svg>
            }
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public TimelineItem Item { get; set; } = null!;
    [Parameter] public double Width { get; set; }
    [Parameter] public double Height { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool Selectable { get; set; } = true;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private bool _loaded;

    private static string Fmt(double v) =>
        v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
