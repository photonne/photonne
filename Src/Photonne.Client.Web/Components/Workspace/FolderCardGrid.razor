@using Photonne.Client.Web.Models

@* Subcarpetas de la carpeta abierta, como filas compactas en rejilla (patrón
   Drive/Finder): miniatura pequeña, nombre, contador y badges. Compactas a
   propósito — con tarjetas grandes, una carpeta con 8 subcarpetas llenaba la
   pantalla antes de enseñar una sola foto. Solo navegan: el servidor no manda
   CanWrite en las subcarpetas de /api/folders/{id}. *@

<div class="fcg @Class">
    @foreach (var folder in Folders)
    {
        <div class="fcg-item" role="link" tabindex="0"
             aria-label="@($"Abrir carpeta {folder.Name}, {folder.AssetCount} elementos")"
             @key="folder.Id"
             @onclick="() => OnOpen.InvokeAsync(folder)"
             @onkeydown="e => HandleKeyAsync(e, folder)">
            <div class="fcg-thumb">
                @if (folder.ThumbnailUrl != null)
                {
                    <img src="@folder.ThumbnailUrl" alt="" loading="lazy" decoding="async" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" />
                }
            </div>

            <span class="fcg-name" title="@folder.Name">@folder.Name</span>

            @if (folder.IsShared)
            {
                <MudTooltip Text="@SharedTooltip(folder)">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderShared" Size="Size.Small" Class="fcg-badge" />
                </MudTooltip>
            }
            @if (folder.ExternalLibraryId != null)
            {
                <MudTooltip Text="Biblioteca externa">
                    <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Small" Class="fcg-badge" />
                </MudTooltip>
            }

            <span class="fcg-count">@folder.AssetCount</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<FolderItem> Folders { get; set; } = new();
    [Parameter] public EventCallback<FolderItem> OnOpen { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task HandleKeyAsync(KeyboardEventArgs e, FolderItem folder) =>
        e.Key is "Enter" or " " ? OnOpen.InvokeAsync(folder) : Task.CompletedTask;

    private static string SharedTooltip(FolderItem folder) =>
        folder.SharedWithCount > 0
            ? $"Compartida con {folder.SharedWithCount} {(folder.SharedWithCount == 1 ? "persona" : "personas")}"
            : "Compartida";
}
