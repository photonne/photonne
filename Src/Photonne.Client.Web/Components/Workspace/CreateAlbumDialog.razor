@using Photonne.Client.Web.Models
@using Photonne.Client.Web.Services
@inject IAlbumsService AlbumsService
@inject ISnackbar Snackbar

@* Crear álbum manual o smart. El smart lleva el editor de reglas con preview
   en vivo; su regla queda fijada al crear (el API no permite editarla luego). *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Nuevo álbum</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Nombre" Variant="Variant.Outlined"
                      Margin="Margin.Dense" AutoFocus="true" />
        <MudTextField @bind-Value="_description" Label="Descripción (opcional)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Lines="2" Class="mt-2 mb-2" />

        <MudTabs @bind-ActivePanelIndex="_tab" Class="mt-2">
            <MudTabPanel Text="Manual">
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">
                    Añadirás fotos a mano desde la selección del timeline.
                </MudText>
            </MudTabPanel>
            <MudTabPanel Text="Smart">
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">
                    El contenido lo decide una regla, siempre al día. La regla se
                    fija al crear el álbum.
                </MudText>
                <SmartRuleEditor Preview="rule => AlbumsService.PreviewRuleAsync(rule)"
                                 RuleChanged="rule => _rule = rule" />
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="!CanCreate || _busy"
                   OnClick="CreateAsync">
            Crear
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _name = string.Empty;
    private string? _description;
    private int _tab;
    private SmartRuleNode? _rule;
    private bool _busy;

    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(_name) && (_tab == 0 || _rule != null);

    private async Task CreateAsync()
    {
        if (!CanCreate) return;
        _busy = true;
        try
        {
            var created = await AlbumsService.CreateAlbumAsync(
                _name.Trim(),
                string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                _tab == 1 ? _rule : null);
            if (created != null)
            {
                MudDialog.Close(DialogResult.Ok(created));
            }
            else
            {
                Snackbar.Add("No se pudo crear el álbum", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
