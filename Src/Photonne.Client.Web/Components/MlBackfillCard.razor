@using System.Net.Http.Headers
@using System.Net.Http.Json
@inject HttpClient Http
@inject IAuthService AuthService
@inject ISnackbar Snackbar

@*
    Reusable admin card that drives a manual ML backfill ("encolar pendientes").
    It fetches pending counts (unprocessed vs already in queue) and hands the
    whole remaining pool to the backfill endpoint in one POST (`All = true`).

    It used to loop POSTs until unprocessed hit zero. That stops only if the pool
    shrinks on every pass, and it doesn't always: a model disabled in Ajustes
    completes each job without recording anything, so the pool came back the same
    size and the loop ran until the admin closed the tab. The server refuses that
    case outright now, and does its own iterating for the rest.

    Enqueued jobs are processed by the enrichment workers independently.
*@

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Title</MudText>
            @if (!string.IsNullOrEmpty(Description))
            {
                <MudText Typo="Typo.body2">@Description</MudText>
            }
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (_loading)
        {
            <div class="d-flex justify-center my-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else if (_loadError != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                No se pudo leer el estado: @_loadError
            </MudAlert>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="RefreshPendingAsync">
                Reintentar
            </MudButton>
        }
        else
        {
            <MudGrid Class="mb-3">
                <MudItem xs="6">
                    <MudPaper Elevation="0" Class="pa-3" Style="border:1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin encolar</MudText>
                        <MudText Typo="Typo.h5" Color="@(_unprocessed > 0 ? Color.Primary : Color.Default)">
                            @_unprocessed.ToString("N0")
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6">
                    <MudPaper Elevation="0" Class="pa-3" Style="border:1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">En cola</MudText>
                        <MudText Typo="Typo.h5" Color="@(_inQueue > 0 ? Color.Info : Color.Default)">
                            @_inQueue.ToString("N0")
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_unprocessed == 0 && _inQueue == 0 && !_running)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                    No hay fotos pendientes — todo está procesado.
                </MudAlert>
            }
            else if (_unprocessed == 0 && _inQueue > 0 && !_running)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Todo lo pendiente está ya en cola. El motor de ML lo irá procesando en segundo plano;
                    no hay nada nuevo que encolar.
                </MudAlert>
            }

            @if (_running)
            {
                @* One request that queues the whole pool: there are no batches
                   left to count, so an indeterminate bar is the honest one. *@
                <MudProgressLinear Color="Color.Primary"
                                   Indeterminate="true"
                                   Class="mb-3"
                                   Rounded="true"
                                   Size="Size.Medium" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">@_status</MudText>
            }
            else if (_lastSummary != null)
            {
                <MudAlert Severity="@_lastSeverity" Dense="true" Class="mb-3">@_lastSummary</MudAlert>
            }

            <div class="d-flex gap-2">
                @if (!_running)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Replay"
                               Disabled="@(_unprocessed == 0)"
                               OnClick="StartAsync">
                        Iniciar
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="Cancel">
                        Detener
                    </MudButton>
                }
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Outlined.Refresh"
                           Disabled="_running"
                           OnClick="RefreshPendingAsync">
                    Actualizar
                </MudButton>
            </div>

            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
                Detener solo abandona la espera; lo que el servidor ya haya encolado se procesa en segundo plano.
            </MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    /// <summary>Display title (e.g., "Reconocimiento facial").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Optional secondary line under the title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>URL slug — face-recognition / object-detection / scene-classification / text-recognition.</summary>
    [Parameter, EditorRequired] public string EndpointKey { get; set; } = "";

    /// <summary>Base path the slug hangs off. Defaults to the admin maintenance
    /// group; user-scoped variants pass e.g. "/api/people/face-recognition" so
    /// the same component drives both a global and a per-user backfill.</summary>
    [Parameter] public string EndpointBase { get; set; } = "/api/admin/maintenance";

    private bool _loading = true;
    private bool _running;
    private string? _loadError;
    private int _unprocessed;
    private int _inQueue;
    private int _enqueuedThisSession;
    private string? _lastSummary;
    private Severity _lastSeverity = Severity.Success;
    private string _status = "";
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync() => await RefreshPendingAsync();

    private async Task RefreshPendingAsync()
    {
        _loadError = null;
        try
        {
            await AttachAuthAsync();
            var resp = await Http.GetFromJsonAsync<PendingCountDto>(
                $"{EndpointBase}/{EndpointKey}/pending-count");
            _unprocessed = resp?.Unprocessed ?? 0;
            _inQueue = resp?.InQueue ?? 0;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Snackbar.Add($"No se pudo leer pendientes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartAsync()
    {
        if (_unprocessed == 0) return;

        _cts = new CancellationTokenSource();
        _running = true;
        _enqueuedThisSession = 0;
        _lastSummary = null;
        _status = "Encolando…";

        try
        {
            await AttachAuthAsync();
            var resp = await Http.PostAsJsonAsync(
                $"{EndpointBase}/{EndpointKey}/backfill",
                new { OnlyMissing = true, All = true },
                _cts.Token);

            // A refused backfill (the model is off) comes back as 409 with the
            // reason in the body — show that, not "Conflict".
            if (!resp.IsSuccessStatusCode)
            {
                var problem = await ReadErrorAsync(resp, _cts.Token);
                Snackbar.Add(problem, Severity.Error);
                _lastSummary = problem;
                _lastSeverity = Severity.Error;
                return;
            }

            var result = await resp.Content.ReadFromJsonAsync<BackfillResultDto>(cancellationToken: _cts.Token);
            _enqueuedThisSession = result?.Enqueued ?? 0;
            _unprocessed = Math.Max(0, (result?.Total ?? 0) - _enqueuedThisSession);
            _inQueue += _enqueuedThisSession;

            _lastSeverity = _enqueuedThisSession > 0 ? Severity.Success : Severity.Info;
            _lastSummary = _enqueuedThisSession > 0
                ? $"Encolados {_enqueuedThisSession:N0}. Los procesará el motor de ML en segundo plano."
                : "No había nada que encolar.";
            Snackbar.Add(_lastSummary, _lastSeverity);
        }
        catch (OperationCanceledException)
        {
            // Cancelling now only drops our end of the request: whatever the
            // server already committed stays queued, and the count refresh in
            // `finally` is what tells the admin how much that was.
            _lastSeverity = Severity.Info;
            _lastSummary = "Petición cancelada; lo que el servidor ya hubiera encolado sigue en cola.";
            Snackbar.Add(_lastSummary, _lastSeverity);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task AttachAuthAsync()
    {
        var token = await AuthService.GetTokenAsync();
        Http.DefaultRequestHeaders.Authorization = string.IsNullOrEmpty(token)
            ? null : new AuthenticationHeaderValue("Bearer", token);
    }


    /// <summary>Pulls the server's own wording out of an `{"error": "…"}` body,
    /// falling back to the status line when there isn't one.</summary>
    private static async Task<string> ReadErrorAsync(HttpResponseMessage resp, CancellationToken ct)
    {
        try
        {
            var body = await resp.Content.ReadFromJsonAsync<ErrorDto>(cancellationToken: ct);
            if (!string.IsNullOrWhiteSpace(body?.Error)) return body!.Error;
        }
        catch { /* not a JSON error body */ }
        return $"El servidor respondió {(int)resp.StatusCode}.";
    }

    private sealed record ErrorDto(string Error);
    private sealed record PendingCountDto(int Unprocessed, int InQueue);
    private sealed record BackfillResultDto(int Enqueued, int Total);
}
