@implements IDisposable
@inject NavigationManager Navigation
@inject Photonne.Client.Web.Services.IOrganizeService OrganizeService
@inject Photonne.Client.Web.Services.IAuthService AuthService

<div class="nav-wrapper">
<MudNavMenu Class="mt-4">
    @if (IsSettingsSection)
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ArrowBack" IconColor="Color.Inherit">
            Volver
        </MudNavLink>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/settings/profile"    Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Person"   IconColor="Color.Inherit">Perfil</MudNavLink>
        <MudNavLink Href="/settings/security"   Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Lock"     IconColor="Color.Inherit">Seguridad</MudNavLink>
        <MudNavLink Href="/settings/appearance" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Palette"  IconColor="Color.Inherit">Apariencia</MudNavLink>
    }
    else
    {
        <MudNavLink Href="/fotos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.PhotoLibrary" IconColor="Color.Inherit">
            Fotos
        </MudNavLink>

        <MudNavLink Href="/buscar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Search" IconColor="Color.Inherit">
            Buscar
        </MudNavLink>

        <MudNavLink Href="/albumes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.PhotoAlbum" IconColor="Color.Inherit">
            Álbumes
        </MudNavLink>

        <MudNavLink Href="/carpetas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Folder" IconColor="Color.Inherit">
            Carpetas
        </MudNavLink>

        <MudNavLink Href="/organizar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AutoAwesomeMotion" IconColor="Color.Inherit">
            <div class="d-flex align-center gap-2">
                <span>Organizar</span>
                @if (_organizeCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="nav-count-chip">@_organizeCount</MudChip>
                }
            </div>
        </MudNavLink>

        <MudNavGroup Title="Colecciones" Icon="@Icons.Material.Outlined.Collections" Expanded="false">
            <MudNavLink Href="/favoritas" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.FavoriteBorder">Favoritas</MudNavLink>
            <MudNavLink Href="/archivadas" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Archive">Archivadas</MudNavLink>
            <MudNavLink Href="/papelera" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Delete">Papelera</MudNavLink>
            <MudNavLink Href="/duplicados" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ContentCopy">Duplicados</MudNavLink>
        </MudNavGroup>

        <MudNavLink Href="/notifications" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Notifications" IconColor="Color.Inherit">
            Notificaciones
        </MudNavLink>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudDivider Class="my-2" />

                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard" IconColor="Color.Inherit">
                    Panel
                </MudNavLink>

                <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.People" IconColor="Color.Inherit">
                    Usuarios
                </MudNavLink>

                <MudNavLink Href="/admin/libraries" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.FolderSpecial" IconColor="Color.Inherit">
                    Bibliotecas externas
                </MudNavLink>

                <MudNavLink Href="/admin/stats" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.QueryStats" IconColor="Color.Inherit">
                    Estadísticas
                </MudNavLink>

                <MudNavGroup Title="Tareas" Icon="@Icons.Material.Outlined.PlaylistPlay" Expanded="true">
                    <MudNavLink Href="/admin/system/tasks" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Tune">Colas y tareas</MudNavLink>
                    <MudNavLink Href="/admin/system/maintenance" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.CleaningServices">Mantenimiento</MudNavLink>
                    <MudNavLink Href="/admin/system/backup" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Backup">Copia de seguridad</MudNavLink>
                </MudNavGroup>

                <MudNavLink Href="/utilities" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Build" IconColor="Color.Inherit">
                    Utilidades
                </MudNavLink>

                <MudNavLink Href="/shared-trash" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.DeleteSweep" IconColor="Color.Inherit">
                    Papelera compartida
                </MudNavLink>

                <MudDivider Class="my-2" />

                <MudNavLink Href="/admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings" IconColor="Color.Inherit">
                    Ajustes del servidor
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
    }
</MudNavMenu>
</div>

@code {
    private bool IsSettingsSection
        => new Uri(Navigation.Uri).AbsolutePath.Trim('/').StartsWith("settings", StringComparison.OrdinalIgnoreCase);

    private int _organizeCount;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await RefreshOrganizeCountAsync();
    }

    private async Task RefreshOrganizeCountAsync()
    {
        try
        {
            if (await AuthService.IsAuthenticatedAsync())
            {
                _organizeCount = (await OrganizeService.GetCountAsync()).Count;
            }
        }
        catch
        {
            // El badge es cosmético: sin red o sin permiso, simplemente no sale.
        }
    }

    private bool _wasInOrganize;

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Refrescar el contador solo AL SALIR de /organizar (los movimientos
        // hechos allí lo cambian); el resto de navegaciones no piden nada.
        var inOrganize = new Uri(e.Location).AbsolutePath
            .StartsWith("/organizar", StringComparison.OrdinalIgnoreCase);
        if (_wasInOrganize && !inOrganize)
        {
            await RefreshOrganizeCountAsync();
        }
        _wasInOrganize = inOrganize;
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
