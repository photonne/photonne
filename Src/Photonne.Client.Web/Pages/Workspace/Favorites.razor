@page "/favoritas"
@using Photonne.Client.Web.Components.Workspace
@using Photonne.Client.Web.Services

<PageTitle>Favoritas - Photonne</PageTitle>

<div class="pa-4">
    <PageHeader Title="Favoritas" />
    <WorkspaceCollection Source="LoadPage"
                         EmptyIcon="@Icons.Material.Outlined.FavoriteBorder"
                         EmptyTitle="Sin favoritas todavía"
                         EmptyDescription="Marca fotos con el corazón (o la tecla F) y aparecerán aquí." />
</div>

@code {
    [Inject] private IAssetService AssetService { get; set; } = null!;

    private async Task<WorkspaceCollection.CollectionPage> LoadPage(object? cursor)
    {
        var page = await AssetService.GetFavoritesPageAsync(cursor as DateTime?);
        return new WorkspaceCollection.CollectionPage(page.Items, page.HasMore, page.NextCursor);
    }
}
