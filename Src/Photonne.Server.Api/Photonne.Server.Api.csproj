<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- ImageSharp 4.x valida la licencia al compilar. El paquete solo busca sixlabors.lic
             hacia abajo desde este directorio, así que apuntamos al de la raíz del repo
             (git-ignored). En CI la ruta llega por /p:SixLaborsLicenseFile desde un secret. -->
        <SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\sixlabors.lic')">$(MSBuildThisFileDirectory)..\..\sixlabors.lic</SixLaborsLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ErrorOr" Version="2.1.1" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.1" />
        <PackageReference Include="MetadataExtractor" Version="2.9.3" />
        <PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
        <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Photonne.Client.Web\Photonne.Client.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Photonne.Server.Api.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="thumbnails\979\medium.jpg" />
      <None Remove="thumbnails\28\large.jpg" />
      <None Remove="thumbnails\276\small.jpg" />
      <None Remove="thumbnails\276\medium.jpg" />
      <None Remove="thumbnails\275\small.jpg" />
      <None Remove="thumbnails\274\small.jpg" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Migrations\" />
    </ItemGroup>
</Project>