<Project>
  <PropertyGroup>
    <!-- Las carpetas y los .csproj van sin prefijo (src/Server.Api/Server.Api.csproj);
         la DLL y el namespace por defecto lo recuperan: Photonne.Server.Api. -->
    <AssemblyName>Photonne.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Photonne.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Versión del componente server (API .NET + SPA, que va dentro de la
         misma imagen). La sube release-please en la PR "chore: release server"
         (componente "." en release-please-config.json). ML y las apps
         nativas versionan aparte: src/Server.Ml/version.txt y
         src/Client.Native/version.txt. -->
    <Version>2.9.0</Version>

    <!-- Compatibilidad entre el servidor y las apps nativas, que se versionan
         y se publican por separado. Se suben A MANO (release-please solo toca
         <Version>):
         - PhotonneMinClientVersion: la app más antigua que este servidor
           atiende bien, en versiones de la app (src/Client.Native/version.txt).
           Súbelo a la primera versión de la app que entiende el cambio cuando
           se rompe el contrato de la API (quita o cambia un endpoint o un
           campo que las apps usan).
         - PhotonneMinServerVersion: el servidor más antiguo que esta app
           necesita, en versiones del servidor (<Version> de arriba). Súbelo
           cuando la app empiece a usar un endpoint o campo nuevo del servidor.
         Si alguno no se cumple, la app avisa de qué hay que actualizar.
         La CI (api-contract.yml) rechaza un cambio incompatible del contrato
         OpenAPI salvo que la misma PR suba PhotonneMinClientVersion; ver
         docs/api-compatibilidad.md. -->
    <PhotonneMinClientVersion>1.159.0</PhotonneMinClientVersion>
    <PhotonneMinServerVersion>2.10.0</PhotonneMinServerVersion>
  </PropertyGroup>
</Project>
