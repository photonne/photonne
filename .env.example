# Copia este archivo como .env y rellena los valores obligatorios (marcados con*)
# docker compose up -d lee automáticamente el archivo .env de la misma carpeta

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=photonne
POSTGRES_USER=photonne_user
POSTGRES_PASSWORD=cambia_esto_por_password_seguro        # * obligatorio
# Versión de PostgreSQL: pg17, o pg18 en una instalación nueva. Pasar una base
# de datos existente de 17 a 18 requiere volcarla y restaurarla
# (docs/postgres-operations.md, «Pasar a PostgreSQL 18»).
POSTGRES_TAG=pg17

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres, aleatorio. Puedes generar uno con:
#   openssl rand -base64 48
# Si lo dejas vacío, el servidor genera una clave y la guarda en
# CONFIG_HOST_PATH/jwt.key. Los valores de ejemplo se ignoran.
JWT_KEY=

# ─── Rutas del HOST ───────────────────────────────────────────────────────────
# Estructura recomendada: un único árbol `photonne/data/` bajo el home del
# usuario, con dos subcarpetas (`assets/` y `thumbnails/`). Queda fuera del
# repo, no requiere permisos de root/admin y es fácil de encontrar desde el
# explorador de archivos. Si no las creas a mano, Docker las hace al arrancar.
#
# Importante: Compose NO expande `~` ni `${HOME}` en los valores del .env.
# Usa siempre rutas absolutas (con letra de unidad en Windows).
#
# Dónde están tus fotos en el host (se monta en /data/assets dentro del contenedor)
# Linux:   /home/<TuUsuario>/photonne/data/assets
# macOS:   /Users/<TuUsuario>/photonne/data/assets
# Windows: C:/Users/<TuUsuario>/photonne/data/assets
ASSETS_HOST_PATH=./photonne/data/assets

# Dónde se guardan las miniaturas en el host (se monta en /data/thumbnails dentro del contenedor)
# Linux:   /home/<TuUsuario>/photonne/data/thumbnails
# macOS:   /Users/<TuUsuario>/photonne/data/thumbnails
# Windows: C:/Users/<TuUsuario>/photonne/data/thumbnails
THUMBNAILS_HOST_PATH=./photonne/data/thumbnails

# Configuración que genera el servidor (la clave JWT si no defines JWT_KEY).
# Se monta en /data/config dentro del contenedor.
CONFIG_HOST_PATH=./photonne/data/config

# ─── Puerto externo de la app ─────────────────────────────────────────────────
# Único para dev y prod. En macOS evita 5000 (lo ocupa AirPlay Receiver de
# serie desde Monterey) y 7000 (también AirPlay).
API_PORT=1107

# ─── Usuario administrador (se crea al arrancar si no existe) ─────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@photonne.local
# Si la dejas vacía, el primer arranque genera una y la escribe en el log
# (docker compose logs photonne-api). Los valores de ejemplo se ignoran.
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=Administrador
ADMIN_LASTNAME=Sistema

# ─── Opcionales ───────────────────────────────────────────────────────────────
# Redirigir HTTP a HTTPS (solo si tienes TLS en el propio contenedor, no en proxy)
HTTPS_REDIRECT=false

# ─── ML Service (microservicio Python: caras + objetos) ───────────────────────
# URL interna compartida por todas las capacidades ML (cara, objetos, ...).
# En la API se mapea a Ml__ServiceUrl. En docker-compose se resuelve por DNS.
ML_SERVICE_URL=http://photonne-ml:8000
# Providers de ONNX Runtime (CPU por defecto). Para GPU NVIDIA NO basta con
# cambiar esta variable: la imagen por defecto es solo-CPU. Usa el overlay GPU:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# que trae la imagen photonne-ml:latest-gpu, pasa la GPU al contenedor y fija
# ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider. Requiere driver
# NVIDIA + nvidia-container-toolkit en el host.
# Se puede afinar por tarea (cada una cae a ONNX_PROVIDERS si no se define):
#   FACE_ONNX_PROVIDERS / OBJECT_ONNX_PROVIDERS / SCENE_ONNX_PROVIDERS /
#   TEXT_ONNX_PROVIDERS / EMBEDDING_ONNX_PROVIDERS
# También se puede elegir GPU/CPU por tarea en runtime desde el panel de
# administración (Ajustes de cada capacidad → "Dispositivo de cómputo").
# El overlay GPU deja el OCR en CPU (TEXT_ONNX_PROVIDERS=CPUExecutionProvider)
# porque RapidOCR agota fácilmente la VRAM. CUDA_GPU_MEM_LIMIT_MB limita
# opcionalmente la arena de cada sesión CUDA en tarjetas muy justas.
ML_ONNX_PROVIDERS=CPUExecutionProvider

# ─── Reconocimiento facial ────────────────────────────────────────────────────
# Activa/desactiva el procesamiento de jobs FaceDetection.
FACE_RECOGNITION_ENABLED=true
# Modelo InsightFace (buffalo_l = RetinaFace + ArcFace 512d, ~280 MB).
FACE_MODEL_NAME=buffalo_l
# Tamaño de entrada del detector (640 es el sweet spot calidad/velocidad).
FACE_DET_SIZE=640
# Tamaño mínimo de cara en píxeles para considerarla válida.
FACE_MIN_SIZE=40
# Score mínimo del detector (0..1).
FACE_MIN_DET_SCORE=0.5

# ─── Detección de objetos ─────────────────────────────────────────────────────
# Activa/desactiva el procesamiento de jobs ObjectDetection.
# (alias antiguo: OBJECT_RECOGNITION_ENABLED — sigue funcionando como respaldo)
OBJECT_DETECTION_ENABLED=true
# Modelo YOLOv8 ONNX (yolov8n por defecto, COCO-80, ~12 MB).
# La primera vez se descarga automáticamente al volumen ml_models.
OBJECT_MODEL_PATH=/app/models/yolov8n.onnx
# Score mínimo por clase (0..1).
OBJECT_MIN_SCORE=0.25
# Umbral IoU para Non-Max Suppression.
OBJECT_IOU=0.45

# ─── Clasificación de escenas ─────────────────────────────────────────────────
# Activa/desactiva el procesamiento de jobs SceneClassification.
# (alias antiguo: SCENE_RECOGNITION_ENABLED — sigue funcionando como respaldo)
SCENE_CLASSIFICATION_ENABLED=true
# Modelo Places365 ResNet18 ONNX (~45 MB, baked en la imagen).
SCENE_MODEL_PATH=/app/models/scene_classifier.onnx
# Top-K predicciones a devolver/persistir (taxonomía fina, top-1 puede no bastar).
SCENE_TOP_K=3
# Probabilidad mínima para predicciones rank ≥ 2 (rank 1 siempre se emite).
SCENE_MIN_SCORE=0.15

# ─── Vídeo ────────────────────────────────────────────────────────────────────
# Copias H.264 (hasta 1080p) de los vídeos que no se reproducen en todas partes
# (HEVC del iPhone, 4K, AVI, MKV…), de una en una. false en un servidor sin
# potencia para transcodificar: se reproducen los originales.
VIDEO_PLAYBACK_COPIES=true

# ─── Inicio de sesión con un proveedor OpenID (opcional) ──────────────────────
# Authentik, Keycloak, Authelia, Google… Registra en el proveedor la URI de
# redirección <OIDC_PUBLIC_URL>/api/auth/oidc/callback.
OIDC_ENABLED=false
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Lo que dice el botón: «Entrar con …»
OIDC_DISPLAY_NAME=SSO
# Crear la cuenta a quien el proveedor reconoce (con correo verificado) y no
# tiene una aquí. Si no, solo entran las cuentas que ya existen con ese correo.
OIDC_AUTO_CREATE_USERS=false
# La dirección pública del servidor (https://fotos.example.com); necesaria
# detrás de un proxy que no reenvía el esquema.
OIDC_PUBLIC_URL=

# ─── Reconocimiento de texto (OCR) ────────────────────────────────────────────
# Activa/desactiva el procesamiento de jobs TextRecognition.
TEXT_RECOGNITION_ENABLED=true
# Confianza mínima por línea (0..1) — descarta detecciones ruidosas en texturas.
TEXT_MIN_SCORE=0.5
# Tope duro de líneas reconocidas por imagen (defensivo contra documentos largos).
TEXT_MAX_LINES=200
