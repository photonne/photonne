{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "pull-request-header": "Al hacer merge de esta PR se publica la release de este componente: se crea su etiqueta (`<componente>-vX.Y.Z`), se construye lo que le corresponde (imagen Docker versionada con `:latest` incluido, o los instaladores de escritorio) y la release se hace pública cuando todo está listo. Los demás componentes no se tocan.",
  "draft": true,
  "force-tag-creation": true,
  "bootstrap-sha": "e8c2b368ce7de6f176b6d87124574a443fab19ca",
  "changelog-sections": [
    { "type": "feat", "section": "Novedades" },
    { "type": "fix", "section": "Correcciones" },
    { "type": "perf", "section": "Rendimiento" },
    { "type": "revert", "section": "Reversiones" },
    { "type": "refactor", "section": "Otros cambios" },
    { "type": "docs", "section": "Documentación", "hidden": true },
    { "type": "style", "section": "Otros cambios", "hidden": true },
    { "type": "test", "section": "Otros cambios", "hidden": true },
    { "type": "build", "section": "Otros cambios", "hidden": true },
    { "type": "ci", "section": "Otros cambios", "hidden": true },
    { "type": "chore", "section": "Otros cambios", "hidden": true }
  ],
  "packages": {
    ".": {
      "component": "server",
      "exclude-paths": [
        "src/Server.Ml",
        "src/Client.Native",
        "docs/site"
      ],
      "extra-files": [
        {
          "type": "xml",
          "path": "Directory.Build.props",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ]
    },
    "src/Server.Ml": {
      "component": "ml"
    },
    "src/Client.Native": {
      "component": "native"
    }
  }
}
